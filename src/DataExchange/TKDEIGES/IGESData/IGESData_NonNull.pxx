#ifndef _IGESData_NonNull_HeaderFile
#define _IGESData_NonNull_HeaderFile

#include <Standard_Handle.hxx>
#include <Standard_NullObject.hxx>

//! Returns theHandle, or throws Standard_NullObject if it is null.
//! The Init() of an entity receives the lists read from the file: a list is not created when its
//! size is not read (damaged file), and dereferencing it crashed. The exception is caught by the
//! reader, which reports the entity as failed.
template <class T>
const occ::handle<T>& IGESData_NonNull(const occ::handle<T>& theHandle, const char* theWhere)
{
  if (theHandle.IsNull())
  {
    throw Standard_NullObject(theWhere);
  }
  return theHandle;
}

#endif // _IGESData_NonNull_HeaderFile
